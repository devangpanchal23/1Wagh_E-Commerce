# Server Environment Variables
PORT=5050
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wagh-ecommerce?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRE=30d
JWT_EXPIRE=30d
CLIENT_URL=https://your-frontend-domain.com
NODE_ENV=production

# Admin Auth Config
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_admin_password
ADMIN_JWT_SECRET=your_dedicated_admin_jwt_secret_min_32_chars

# Google Drive Integration
GOOGLE_CLIENT_ID=your_gcp_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_gcp_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_gcp_oauth_client_secret
GOOGLE_API_KEY=your_google_api_key
GOOGLE_REDIRECT_URI=postmessage
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_32bytes

# GitHub-backed product image storage (Contents API + jsDelivr CDN)
# Token needs the "repo" (or "contents:write" for a fine-grained token) scope
# on GITHUB_REPO. Never exposed to the frontend — read only on the server.
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_image_storage_repo
GITHUB_BRANCH=main

# Razorpay Config
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (Resend / SMTP fallback)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=orders@your-domain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=orders@your-domain.com

# SMS OTP (optional gateways, first one configured wins)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Receipt / company details
COMPANY_NAME=Wagh E-Commerce
COMPANY_GSTIN=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=Wagh Mobile Accessories, 20-A, Daheri Faliyu, Opposite Jalaram Bungalows, Near Ideal Pre-School, Nana Varachha, Surat, Gujarat - 395010

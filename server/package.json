{
  "name": "wagh-ecommerce-server",
  "version": "1.0.0",
  "description": "Backend REST API for WAGH Mobile Accessories E-commerce Platform",
  "main": "src/server.js",
  "scripts": {
    "predev": "node scripts/predev.js",
    "start": "node src/server.js",
    "dev": "node --watch --watch-path=.env --watch-path=src src/server.js",
    "seed": "node seed.js",
    "sync-indexes": "node scripts/syncIndexes.js",
    "migrate-db": "node scripts/migrate-mongodb.js",
